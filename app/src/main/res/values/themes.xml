<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FerramentaFacil" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/laranja</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryContainer">@color/laranja_claro</item>
        <item name="colorOnPrimaryContainer">@color/laranja_escuro</item>
        <item name="colorSecondary">@color/amarelo</item>
        <item name="colorOnSecondary">@color/texto_primario</item>
        <item name="colorSecondaryContainer">@color/amarelo_claro</item>
        <item name="colorOnSecondaryContainer">@color/texto_primario</item>
        <item name="colorSurface">@color/branco</item>
        <item name="colorOnSurface">@color/texto_primario</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/laranja_escuro</item>
        <item name="materialButtonStyle">@style/Widget.FerramentaFacil.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.FerramentaFacil.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.FerramentaFacil.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.FerramentaFacil.Card</item>
    </style>

    <!-- Tema da tela de abertura: fundo laranja sem "piscar" branco -->
    <style name="Theme.FerramentaFacil.Splash">
        <item name="android:windowBackground">@color/laranja</item>
        <item name="android:statusBarColor">@color/laranja</item>
    </style>

    <!-- Botões com cantos arredondados -->
    <style name="Widget.FerramentaFacil.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.FerramentaFacil.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/laranja</item>
    </style>

    <style name="Widget.FerramentaFacil.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/laranja</item>
        <item name="hintTextColor">@color/laranja</item>
    </style>

    <style name="Widget.FerramentaFacil.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/laranja</item>
        <item name="hintTextColor">@color/laranja</item>
    </style>

    <style name="Widget.FerramentaFacil.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/branco</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Formas para ShapeableImageView -->
    <style name="ShapeCirculo">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeArredondado">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Textos -->
    <style name="TituloSecao">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_primario</item>
    </style>

    <style name="Rotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_primario</item>
    </style>

    <style name="TextoSecundario">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <!-- Linhas de opção do perfil -->
    <style name="OpcaoPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/laranja</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Linhas "rótulo : valor" do resumo do aluguel -->
    <style name="ResumoRotulo">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ResumoValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
